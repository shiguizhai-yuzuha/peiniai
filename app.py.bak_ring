# ============ 纪念页 ============

def _fmt_day(raw):
    """库里存的是 UTC，显示时转成本地日期。"""
    if not raw:
        return "——"
    try:
        from datetime import datetime, timedelta
        return (datetime.fromisoformat(str(raw)) + timedelta(hours=8)).strftime("%Y-%m-%d")
    except Exception:
        return str(raw)[:10]


def render_milestones(user_id, persona):
    """纪念页：只显示已经发生过的事，顶部一条细进度。

    刻意不做的事：不显示"未解锁 ???"的占位卡——还没发生的事不该剧透。
    """
    if not user_id:
        return ("<div style='padding:40px;text-align:center;color:#bbb;font-size:15px'>"
                "请先登录。</div>")

    # hidden: 开头的是内部标记（彩蛋等），不当成纪念显示
    items = [m for m in repo.get_milestones(user_id, persona)
             if not str(m.get("key", "")).startswith("hidden:")]
    if not items:
        return ("<div style='padding:40px;text-align:center;color:#bbb;font-size:15px'>"
                "还没有什么。<br>你们才刚认识。</div>")

    total = len(milestones.DEFS)
    got = len(items)
    pct = int(got * 100 / total) if total else 0

    bar = (
        "<div style='display:flex;align-items:center;gap:12px;margin:0 0 18px'>"
        "<div style='flex:1;height:6px;background:rgba(255,255,255,0.14);"
        "border-radius:3px;overflow:hidden'>"
        f"<div style='width:{pct}%;height:100%;background:#95ec69'></div>"
        "</div>"
        f"<div style='font-size:12px;color:#9aa0a6;white-space:nowrap'>{got} / {total}</div>"
        "</div>"
    )

    cards = []
    for m in items:
        # 好感跨坎没法还原真实日期（库里没有历史曲线），标成"时间不详"而不是假的日期
        if m.get("key") in ("intimacy_50", "intimacy_80"):
            day = "时间不详"
        else:
            day = _fmt_day(m.get("unlocked_at"))
        title = m.get("title") or ""
        cards.append(
            "<div style='background:rgba(20,20,24,0.74);border-radius:14px;"
            "padding:16px 18px;margin:0 0 12px;border-left:3px solid #95ec69;'>"
            f"<div style='font-size:15px;color:#f2f2f2;line-height:1.6'>{title}</div>"
            f"<div style='font-size:12px;color:#8d8d8d;margin-top:6px'>{day}</div>"
            "</div>"
        )

    return (
        "<div style='max-width:640px;margin:0 auto;padding:8px 0'>"
        f"<div style='color:#bbb;font-size:13px;margin-bottom:10px'>"
        f"和「{persona}」之间，已经发生过的 {got} 件事：</div>"
        + bar
        + "".join(cards)
        + "</div>"
    )


def open_milestones(user_id, persona):
    """打开纪念页：藏起聊天区，渲染卡片。"""
    return (
        gr.update(visible=False),                          # chat_group
        gr.update(visible=True),                           # milestone_group
        render_milestones(user_id, persona),               # milestone_html
    )


# ============ 关系渲染（按角色独立） ============

def render_relationship(user_id, persona):
    if not user_id:
        return ""

    # 好感度与表白状态按角色独立：读 user_characters（chat.py 现在写的就是这张表）
    char = repo.get_character_state(user_id, persona)
    intimacy = char.get("intimacy", 0)
    is_lover = bool(char.get("confessed_at"))

    if is_lover:
        stage_label = "恋人"
        heart_str = "💕"
    else:
        display = min(intimacy, 55)
        if intimacy >= 55:
            stage_label = "暧昧期"
            heart_str = "💗"
        else:
            stage = relationship.get_stage(display, False)
            stage_label = relationship.STAGE_NAMES.get(stage, stage)
            hearts = min(5, int(display / 12))
            heart_str = "❤️" * hearts + "🤍" * (5 - hearts)

    return (
        f"<div style='font-size:16px;color:#fff'>"
        f"关系：<b>{stage_label}</b> {heart_str}"
        f"</div>"
    )


def load_history(user_id, persona):
    if not user_id:
        return []
    history = repo.get_recent_messages(user_id, persona, limit=20)
    result = []
    for m in history:
        if m["role"] == "assistant":
            for chunk in split_chunks(m["content"], max_chunks=20, merge=False):
                result.append({"role": "assistant", "content": chunk})
        else:
            result.append({"role": m["role"], "content": m["content"]})
    return result


def opening_history(persona):
    """聊天记录为空时，让她先说第一句。

    只用于展示，不写进 messages 表——
    这样既不用花 token，也不会污染统计和记忆。
    """
    lines = personas.get_openings(persona)
    if not lines:
        return []
    return [{"role": "assistant", "content": random.choice(lines)}]


# ============ 核心对话 ============

def respond(message, chat_history, user_id, session_id, persona, guest_token=None):
    # 游客：只有"没有 user_id 但有凭证"才走免登录。
    # 这样登录之后即使 guest_token 还留着，也不会串到游客路径。
    if guest_token and not user_id:
        yield from _respond_guest(message, chat_history, guest_token, persona)
        return

    if not user_id:
        yield "", chat_history + [
            {"role": "user", "content": message},
            {"role": "assistant", "content": "⚠️ 请先登录"},
        ], gr.update(), "", gr.update(), gr.update()
        return

    if not message.strip():
        yield "", chat_history, gr.update(), "", gr.update(), gr.update()
        return

    chat_history = chat_history + [{"role": "user", "content": message}]

    # 顶部状态条：像微信标题栏一样显示"XX正在输入……"
    # 它只活在这一轮里，不写进聊天记录，所以刷新不会残留。
    typing = ""
    if random.random() < TYPING_HINT_CHANCE:
        typing = f"{persona}正在输入……"

    yield "", chat_history, gr.update(), typing, gr.update(), gr.update()

    with _input_lock:
        if user_id not in _input_buffers:
            _input_buffers[user_id] = {"messages": [], "seq": 0, "persona": persona}
        _input_buffers[user_id]["messages"].append(message)
        _input_buffers[user_id]["seq"] += 1
        my_seq = _input_buffers[user_id]["seq"]

    time.sleep(INPUT_WAIT_SECONDS)

    with _input_lock:
        buf = _input_buffers.get(user_id)
        if not buf:
            yield "", chat_history, gr.update(), "", gr.update(), gr.update()
            return
        if buf.get("persona") != persona:
            print(f"[丢弃] 角色已切换 user={user_id[:8]}", flush=True)
            yield "", chat_history, gr.update(), "", gr.update(), gr.update()
            return
        if buf["seq"] != my_seq:
            # 后面还有消息，让最新的那次去处理；状态条清掉，免得卡住
            yield "", chat_history, gr.update(), "", gr.update(), gr.update()
            return
        msgs = buf["messages"].copy()
        _input_buffers[user_id] = {"messages": [], "seq": 0, "persona": persona}

    # 防抖结束：把这一轮收到的几条消息一起交给业务层。
    # 界面上它们已经是独立气泡（上面每收到一条就 yield 过一次聊天记录），
    # 这里传列表，是为了让它们也"一条一行"入库 —— 否则刷新/切角色后会被粘成一条。
    print(f"[缓冲] user={user_id[:8]} persona={persona} 合并 {len(msgs)} 条", flush=True)

    try:
        got_any = False
        for chunk, err in handle_message(user_id, session_id, msgs, persona):
            got_any = True
            content = chunk or err
            typing = ""          # 第一条真回复来了，状态条收掉
            chat_history = chat_history + [{"role": "assistant", "content": content}]
            yield "", chat_history, gr.update(value=render_relationship(user_id, persona)), typing, gr.update(), gr.update()
        if not got_any:
            print(f"[睡眠] 静默处理 user={user_id[:8]}", flush=True)
        yield "", chat_history, gr.update(), "", gr.update(), gr.update()
    except Exception as e:
        print(f"发生异常：{e}")
        traceback.print_exc()
        chat_history = chat_history + [{"role": "assistant", "content": f"⚠️ 出错：{e}"}]
        yield "", chat_history, gr.update(), "", gr.update(), gr.update()




# ============ 新建角色 ============

def toggle_create():
    return gr.update(visible=True)
# ============ 新建角色：校验 / 导入 / 生成 / 写库 / 切界面 ============
# 拆成四步，每步只做一件事。调度在 do_create_persona。

def _create_fail(msg, session_id):
    """统一的失败返回。"""
    return msg, gr.update(), gr.update(), [], "", session_id
def do_create_persona(name, call_me, quote, state, target, user_id, session_id, raw=""):
    """生成一个私有角色，并把界面切到它。

    具体五步在 core.persona_create 里，这里只管调度和界面。
    """
    err = persona_create.check(name, quote, user_id)
    if err:
        return _create_fail(err, session_id)

    imported = persona_create.import_chat(user_id, raw, call_me)

    r, err = persona_create.generate(user_id, name, call_me, quote,
                                     state, target, imported)
    if err:
        return _create_fail(err, session_id)

    cid, knows, stage, err = persona_create.save(user_id, name, call_me,
                                                 target, r, imported)
    if err:
        return _create_fail(err, session_id)

    key = personas.custom_key(cid)
    choices = personas.list_for_user(user_id)
    history = opening_history(key)
    bg = get_bg_style(key, user_id=user_id)
    new_session = str(uuid.uuid4())

    print(f"[新建角色] user={user_id[:8]} id={cid} name={name} target={target} "
          f"knows={knows} stage={stage}", flush=True)

    msg = (f"✅ **{name}** 已经建好了。\n\n"
           f"她说的第一句是：「{r['opening']}」\n\n"
           f"_她不是你认识的那个人，是根据你给的材料重建的。_")
    return (msg, gr.update(visible=False),
            gr.update(choices=choices, value=key),
            history, bg, new_session)


def show_tell_confirm():
    return gr.update(visible=True)


def hide_tell_confirm():
    return gr.update(visible=False)


def refresh_stage(user_id, persona):
    """刷新状态条 / 告诉她按钮 / 告别页。非私有角色 → 全空。"""
    empty = ("", gr.update(visible=False), "", gr.update(visible=False))
    if not user_id or not persona or not personas.is_custom(persona):
        return empty

    st = stage.stage_of(user_id, persona)
    line = stage.stage_line(user_id, persona)
    bar = ("**%s**" % line) if line else ""

    if st != "E":
        hint = ""
        if stage.needs_tell(st):
            hint = ("\n\n_她还不知道你们已经结束了。如果你告诉她，就回不去了。_")
        return (bar + hint, gr.update(visible=stage.needs_tell(st)),
                "", gr.update(visible=False))

    rows = repo.get_all_messages(user_id, persona)
    body = []
    for m in rows:
        who = "她" if m["role"] == "assistant" else "我"
        txt = (m["content"] or "").replace("<msg>", "  ")
        body.append("%s｜%s" % (who, txt))
    text = "\n".join(body)

    md = ("## 她走了\n\n"
          "她说过的话，都在下面。\n\n"
          "_这些是真的。发生过。_\n\n---\n\n" + text)
    return bar, gr.update(visible=False), md, gr.update(visible=True)


def do_tell(user_id, persona):
    """「告诉她」按钮。不可逆。"""
    if not user_id or not persona:
        return "⚠️ 请先登录。", gr.update(visible=False), "", gr.update(visible=False)
    ok, msg = stage.tell(user_id, persona)
    print("[告诉她] user=%s persona=%s ok=%s" % (str(user_id)[:8], persona, ok), flush=True)
    bar, tell_vis, fmd, fvis = refresh_stage(user_id, persona)
    return msg, tell_vis, fmd, fvis


def _refresh_stage_wrap(u, p):
    return refresh_stage(u, p)


def do_delete_persona(user_id):
    """删掉这个用户所有的自定义角色，连同对话和记忆。"""
    if not user_id:
        return "⚠️ 请先登录。", gr.update(), gr.update()
    rows = repo.list_custom_personas(user_id)
    if not rows:
        return "（你现在没有自定义角色）", gr.update(), gr.update()
    for r in rows:
        repo.delete_custom_persona(r["id"], user_id)
        print("[删角色] user=%s id=%s name=%s" % (str(user_id)[:8], r["id"], r["name"]),
              flush=True)
    choices = personas.list_for_user(user_id)
    return ("✅ 已经删掉了。连对话和记忆一起清的。",
            gr.update(choices=choices, value=DEFAULT_PERSONA),
            gr.update(visible=True))


def _is_vip(user_id):
    u = repo.get_or_create_user(user_id) if user_id else None
    return bool(u and u.get("role") in ("vip", "admin"))


def do_set_bg(user_id, persona, filepath):
    """换背景：压缩 → 存盘 → 入待审。"""
    if not user_id:
        return "⚠️ 请先登录。"
    if not _is_vip(user_id):
        return "⚠️ 换背景现在只对老友开放。\n\n（每一张我要人工看一遍，人多了看不过来。）"
    if not filepath:
        return "⚠️ 先选一张图。"
    if not persona:
        return "⚠️ 先选一个角色。"

    try:
        import uuid as _uuid
        from PIL import Image as _Image

        im = _Image.open(filepath).convert("RGB")
        w, h = im.size
        MAX_W = 1080
        if w > MAX_W:
            im = im.resize((MAX_W, int(h * MAX_W / w)), _Image.LANCZOS)

        d = os.path.join(os.path.dirname(os.path.abspath(__file__)), "static", "user_bg")
        os.makedirs(d, exist_ok=True)

        # 文件名带 user_id，防撞
        safe_persona = "".join(ch for ch in str(persona) if ch.isalnum() or ch in "_-")
        fname = "%s_%s_%s.jpg" % (str(user_id)[:16], safe_persona, _uuid.uuid4().hex[:6])
        out = os.path.join(d, fname)
        im.save(out, "JPEG", quality=78, optimize=True, progressive=True)

        size_kb = os.path.getsize(out) / 1024

        # 旧文件清掉
        old = repo.delete_user_bg(user_id, persona)
        if old and os.path.exists(old):
            try:
                os.remove(old)
            except Exception:
                pass

        repo.set_user_bg(user_id, persona, out, status="pending")
        print("[换背景] user=%s persona=%s %.0fKB → pending" % (str(user_id)[:8], persona, size_kb),
              flush=True)
        return ("✅ 已经换成这张了。\n\n"
                "**切到「%s」就能看到。**" % persona)
    except Exception as e:
        print("[换背景] 失败：%s" % e, flush=True)
        return "⚠️ 换背景失败：%s" % e


def do_reset_bg(user_id, persona):
    if not user_id:
        return "⚠️ 请先登录。"
    old = repo.delete_user_bg(user_id, persona)
    if old and os.path.exists(old):
        try:
            os.remove(old)
        except Exception:
            pass
    print("[换背景] user=%s persona=%s 恢复默认" % (str(user_id)[:8], persona), flush=True)
    return "✅ 「%s」已经用回原来的背景。" % persona


# ============ 把这段带走（导出） ============

def _today():
    from datetime import date
    return date.today().strftime("%Y%m%d")


def _my_personas(user_id):
    try:
        return [x["persona"] for x in gkeep.list_personas(user_id)]
    except Exception:
        return []


def do_export_refresh(user_id):
    if not user_id:
        return "⚠️ 请先登录。", gr.Dropdown(choices=[], value=None)
    ps = _my_personas(user_id)
    if not ps:
        return "还没有可以带走的对话。先去聊几句。", gr.Dropdown(choices=[], value=None)
    return ("选一个角色，或者导出全部。", gr.Dropdown(choices=ps, value=ps[0]))


def do_export_txt(user_id, persona):
    """原始聊天记录，免费。"""
    if not user_id:
        return "⚠️ 请先登录。"
    if not persona:
        return "⚠️ 先选一个角色。"
    try:
        txt = gkeep.render_txt(user_id, persona)
        path, name = gkeep.save("txt", txt, "txt",
                                  stem="陪你AI_聊天记录_%s_%s" % (persona, _today()))
        return ("✅ 好了：**[点这里下载](%s)**　（%s，%d 字）\n\n"
                "下载不了就试这个：[强制下载](%s)"
                % ("/keepsake/" + name, persona, len(txt),
                   "/keepsake/dl/" + name))
    except Exception as e:
        return "⚠️ 导出失败：%s" % e


def do_export_book(user_id, persona):
    """纪念册，一个角色 3 元，vip 免费。"""
    if not user_id:
        return "⚠️ 请先登录。"
    if not persona:
        return "⚠️ 先选一个角色。"
    try:
        user = repo.get_or_create_user(user_id)
        is_vip = (user.get("role") == "vip")
        if not is_vip:
            if not billing.has_balance(user_id, gkeep.PRICE_ONE):
                return "⚠️ 余额不够，这一份要 %.0f 元。" % gkeep.PRICE_ONE
            billing.charge_yuan(user_id, gkeep.PRICE_ONE)

        html_text = gkeep.render_html(user_id, [persona])
        if not html_text:
            if not is_vip:
                repo.update_balance(user_id, gkeep.PRICE_ONE)
            return "⚠️ 这个角色还没有足够的对话。"
        path, name = gkeep.save("html", html_text, "html",
                                  stem="%s_纪念册_%s" % (persona, _today()))
        tip = "（老友免费）" if is_vip else "（扣 %.0f 元）" % gkeep.PRICE_ONE
        return ("✅ 纪念册好了 %s\n\n"
                "**[点这里打开](%s)**　|　**[下载文件](%s)**\n\n"
                "手机直接截长图存下来。电脑上也能 Ctrl+P 存 PDF。"
                % (tip, "/keepsake/" + name, "/keepsake/dl/" + name))
    except Exception as e:
        return "⚠️ 生成失败：%s" % e


def do_export_all(user_id):
    """全部角色，9.9 元，vip 免费。"""
    if not user_id:
        return "⚠️ 请先登录。"
    try:
        ps = _my_personas(user_id)
        if not ps:
            return "⚠️ 还没有可以带走的对话。"
        user = repo.get_or_create_user(user_id)
        is_vip = (user.get("role") == "vip")
        if not is_vip:
            if not billing.has_balance(user_id, gkeep.PRICE_ALL):
                return "⚠️ 余额不够，全部要 %.1f 元。" % gkeep.PRICE_ALL
            billing.charge_yuan(user_id, gkeep.PRICE_ALL)

        html_text = gkeep.render_html(user_id, ps)
        if not html_text:
