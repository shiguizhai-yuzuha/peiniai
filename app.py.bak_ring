                "**[点这里打开](%s)**　|　**[下载文件](%s)**\n\n"
                "手机上直接截长图。电脑上也能 Ctrl+P 存 PDF。"
                % (len(ps), tip, "/keepsake/" + name, "/keepsake/dl/" + name))
    except Exception as e:
        return "⚠️ 生成失败：%s" % e


# ============ 给她做一趟旅行 ============

# 目的地固定杭州。这里列的是"出发地"候选，第一项是自动。
STORY_DEST = "杭州"
STORY_AUTO = "自动（按 IP）"
STORY_ORIGINS = [STORY_AUTO, "新艾利都", "温州", "金华", "宁波", "上海",
                 "苏州", "南京", "合肥", "福州", "南昌", "济南", "北京", "广州"]


def _story_list_md(user_id):
    rows = repo.list_stories(user_id, limit=10)
    if not rows:
        return "_还没有。_"
    out = []
    for r in rows:
        st = r.get("status")
        title = r.get("title") or "（未命名）"
        line = "· **%s**　%s → %s　%s" % (
            title, r.get("origin") or "?", r.get("city") or "?", story_jobs.status_line(r))
        if st == "done":
            line += "　[看](/%s)" % ("story/" + r["id"])
        out.append(line)
    return "\n".join(out)


def build_story_profile(user_id, persona):
    """从记忆里拼一个画像。只读，绝不写库。

    拿的是：名字、喜好、厌恶、最近状态、情绪、态度、好感、信任。
    """
    prof = {"name": "", "likes": [], "dislikes": [], "state": "", "mood": "",
            "attitude": "", "intimacy": 30, "trust": 50}
    try:
        mems = repo.get_memories_all(user_id, persona, limit=120)
    except Exception:
        mems = []

    for m in mems or []:
        k = str(m.get("key") or "")
        v = str(m.get("value") or "").strip()
        if not v:
            continue
        if k == "name" and not prof["name"]:
            prof["name"] = v[:20]
        elif k.startswith("like:") and len(prof["likes"]) < 8:
            prof["likes"].append(v[:20])
        elif k.startswith("dislike:") and len(prof["dislikes"]) < 6:
            prof["dislikes"].append(v[:20])
        elif k == "daily_state" and not prof["state"]:
            prof["state"] = v[:40]
        elif k == "mood" and not prof["mood"]:
            prof["mood"] = v[:30]
        elif k == "attitude" and not prof["attitude"]:
            prof["attitude"] = v[:40]

    try:
        st = repo.get_character_state(user_id, persona) or {}
        prof["intimacy"] = float(st.get("intimacy") or 30)
        prof["trust"] = float(st.get("trust") or 50)
    except Exception:
        pass

    return prof


def do_story_start(user_id, origin_choice, persona=None, request: gr.Request = None):
    """开始生成。目的地固定杭州，出发地按选择或 IP。人设和画像来自当前角色。"""
    if not GALGAME_ENABLED:
        # 2026-11-01 下架。入口已隐藏，这里再拦一道，防止旧页面或直接调用。
        return "这个功能已经下架了。", "_已下架。_"
    if not user_id:
        return "⚠️ 请先登录。", ""

    city = STORY_DEST
    persona = persona or DEFAULT_PERSONA

    # 只读：她的说话方式 + 她记得的你
    try:
        character_text = personas.get_prompt(persona, user_id)
    except Exception as e:
        print("[剧情] 取人设失败：%s" % e, flush=True)
        character_text = None
    profile = build_story_profile(user_id, persona)
    print("[剧情] 画像 %s" % profile, flush=True)

    # 用户指定了就用他选的；选"自动"才去查 IP
    if origin_choice and origin_choice != STORY_AUTO:
        origin = origin_choice
        print("[剧情] 出发地（手动）：%s" % origin, flush=True)
    else:
        try:
            ip = ""
            if request is not None:
                ip = ggeo.client_ip_from_headers(dict(request.headers or {}))
                if not ip and getattr(request, "client", None):
                    ip = request.client.host or ""
            origin = ggeo.locate(ip, destination=city)
            print("[剧情] 定位 %s → 出发地 %s" % (ip or "(空)", origin), flush=True)
        except Exception as e:
            print("[剧情] 定位失败，用新艾利都：%s" % e, flush=True)
            origin = "新艾利都"

    sid, err = story_jobs.start(user_id, city=city, origin=origin,
                                profile=profile, character_text=character_text)
    if not sid:
        return "⚠️ %s" % err, _story_list_md(user_id)

    who = personas.display_name(persona) if hasattr(personas, "display_name") else persona
    msg = ("✅ 开始生成。\n\n"
           "**%s → %s**\n\n"
           "**和谁：%s**（用的她记得的你：%s）\n\n"
           "大约 5 分钟。点「刷新」看进度，好了会有「看」。"
           % (origin, city, who,
              "、".join(profile.get("likes") or []) or "还没什么印象"))
    return msg, _story_list_md(user_id)


def do_story_refresh(user_id):
    if not user_id:
        return "⚠️ 请先登录。", ""
    return story_jobs.quota_line(user_id), _story_list_md(user_id)


def clear_chat():
    return [], str(uuid.uuid4())


# ============ 切换角色 ============

def switch_persona(persona, user_id, session_id):
    print(f"[切换] persona={persona} user={user_id[:8] if user_id else 'None'}", flush=True)

    if user_id:
        with _input_lock:
            _input_buffers.pop(user_id, None)

    history = load_history(user_id, persona) if user_id else []
    new_bg = get_bg_style(persona, user_id=user_id)
    new_session = str(uuid.uuid4())

    return history, new_bg, new_session


# ============ 登录 / 注册 ============

def do_register(username, password, password2, invite_code):
    if password != password2:
        return None, "两次密码不一致", gr.update(visible=True), gr.update(visible=False), []
    ok, msg = validate_username(username)
    if not ok:
        return None, msg, gr.update(visible=True), gr.update(visible=False), []
    ok, msg = validate_password(password)
    if not ok:
        return None, msg, gr.update(visible=True), gr.update(visible=False), []

    user_id, err = repo.register_user(username, password, invite_code)
    if err:
        return None, err, gr.update(visible=True), gr.update(visible=False), []

    return user_id, f"✅ 注册成功，欢迎 {username}", gr.update(visible=False), gr.update(visible=True), opening_history(DEFAULT_PERSONA)


def do_login(username, password):
    user_id, err = repo.login_user(username, password)
    if err:
        return (
            None, err,
            gr.update(visible=True), gr.update(visible=False),
            [],
            DEFAULT_PERSONA,
            get_bg_style(is_login=True),
            "",
        )

    history = load_history(user_id, DEFAULT_PERSONA)
    if not history:
        history = opening_history(DEFAULT_PERSONA)
    rel_html = render_relationship(user_id, DEFAULT_PERSONA)

    return (
        user_id,
        f"✅ 欢迎回来，{username}",
        gr.update(visible=False),
        gr.update(visible=True),
        history,
        DEFAULT_PERSONA,
        get_bg_style(DEFAULT_PERSONA),
        rel_html,
    )


def do_logout():
    return (
        None, "已退出登录",
        gr.update(visible=True),
        gr.update(visible=False),
        [],
        DEFAULT_PERSONA,
        get_bg_style(is_login=True),
        "",
    )


# ============ 免登录试聊 ============

def do_guest(request: gr.Request):
    """开一个游客会话。不进数据库，不建账号。

    返回和 do_login 一样的八元组，界面不动。
    """
    ip = "0.0.0.0"
    try:
        ip = request.client.host or "0.0.0.0"
    except Exception:
        pass

    token, err = guest.open_session(ip)
    if not token:
        wait = guest.ip_wait_seconds(ip)
        mins = max(1, int(wait / 60))
        return (
            None,
            "她已经见过一个人了。%d 分钟后再来，或者直接注册。" % mins,
            gr.update(visible=True), gr.update(visible=False),
            [], DEFAULT_PERSONA, get_bg_style(is_login=True), "",
            None,
            gr.update(),
        )

    openings = OPENINGS.get(guest.GUEST_PERSONA, [])
    history = []
    for line in openings:
        history.append({"role": "assistant", "content": line})
        guest.append(token, "assistant", line)

    print("[游客] 开 %s ip=%s 轮数=%d" % (token[:8], ip, guest.GUEST_TURNS),
          flush=True)

    return (
        None,                      # user_id 保持空，别的面板不会去查库
        "先说几句。说满 %d 轮，她就要跟你说一件事。" % guest.GUEST_TURNS,
        gr.update(visible=False),
        gr.update(visible=True),
        history,
        guest.GUEST_PERSONA,
        get_bg_style(guest.GUEST_PERSONA),
        "",
        token,                     # 第 9 个：游客凭证
        gr.update(value=guest.GUEST_PERSONA),   # 第 10 个：顶部的角色下拉
    )


def do_keep(username, password, token):
    """游客转正：注册 + 继承那十轮。

    邀请码用内部码 GUEST，用户不用输。
    """
    def _fail(msg):
        return (gr.update(), gr.update(), gr.update(), gr.update(),
                gr.update(), gr.update(), msg)

    if not token:
        return _fail("⚠️ 这段对话过期了，刷新页面重来。")

    username = (username or "").strip()
    if len(username) < 2:
        return _fail("用户名至少 2 个字。")
    if len(password or "") < 6:
        return _fail("密码至少 6 位。")

    user_id, err = repo.register_user(username, password, "GUEST")
    if err:
        return _fail("⚠️ " + err)

    sess = guest.close(token)
    persona = guest.GUEST_PERSONA
    history = sess.get("history", []) or []

    sid = str(uuid.uuid4())
    chat_history = []
    said = []

    for h in history:
        role = h.get("role")
        content = (h.get("content") or "").strip()
        if not content:
            continue
        try:
            repo.save_message(sid, user_id, persona, role, content)
        except Exception as e:
            print("[转正] 写消息失败：%s" % e, flush=True)
        chat_history.append({"role": role, "content": content})
        if role == "user" and 2 <= len(content) <= 60:
            said.append(content)

    for i, s in enumerate(said[:3]):
        try:
            repo.upsert_memory(user_id, persona, "guest_%d" % (i + 1),
                               s[:40], priority=7)
        except Exception as e:
            print("[转正] 写记忆失败：%s" % e, flush=True)

    for line in ("……你想起来了。", "我刚才差点把你叫什么忘了。", "现在不会了。"):
        chat_history.append({"role": "assistant", "content": line})
        try:
            repo.save_message(sid, user_id, persona, "assistant", line)
        except Exception:
            pass

    print("[转正] %s 继承 %d 条，记忆 %d 条"
          % (username, len(history), min(3, len(said))), flush=True)

    return (
        user_id,
        gr.update(visible=True),                 # chat_group
        gr.update(visible=False),                # guest_save_group
        chat_history,                            # chatbot
        gr.update(value=""),                     # guest_end_md
        render_relationship(user_id, persona),   # relationship_html
        "✅ 好了。她记得。",                      # guest_save_msg
    )


def _respond_guest(message, chat_history, token, persona):
    """游客版的 respond。不写库，只走 guest 内存。

    输出 6 个：msg / chatbot / relationship_html / typing_status
                / guest_save_group / guest_end_md
    """
    KEEP = (gr.update(), gr.update())      # 两个游客组件的默认值

    if not message.strip():
        yield "", chat_history, gr.update(), "", *KEEP
        return

    chat_history = chat_history + [{"role": "user", "content": message}]
    yield "", chat_history, gr.update(), "", *KEEP

    try:
        guest.append(token, "user", message)
        text, segs = guest_chat.ask(token, persona, message)
        guest.append(token, "assistant", text)
        turn = guest.bump_turn(token)

        for s in segs:
            chat_history = chat_history + [{"role": "assistant", "content": s}]
            yield "", chat_history, gr.update(), "", *KEEP

        print("[游客] %s 第 %d 轮，回 %d 段" % (token[:8], turn, len(segs)),
              flush=True)

        if guest.is_over(token):
            chat_history = chat_history + [
                {"role": "assistant", "content": "—— %s" % guest.ending_line()},
            ]
            yield (gr.update(interactive=False), chat_history, gr.update(), "",
                   gr.update(visible=True), gr.update(value=""))
            return
    except Exception as e:
        print("[游客] 出错：%s" % e, flush=True)
        traceback.print_exc()
        chat_history = chat_history + [
            {"role": "assistant", "content": "⚠️ 她那边断了一下，再说一次。"}]

    yield "", chat_history, gr.update(), "", *KEEP


# ============ UI ============

# ============ 个人主页 ============

def _days_since(ts):
    """UTC 时间戳 → 多少天前。解析失败返回 0，不让主页因为脏数据崩掉。"""
    if not ts:
        return 0
    try:
        t = datetime.strptime(str(ts)[:19], "%Y-%m-%d %H:%M:%S")
        return max(0, (datetime.utcnow() - t).days)
    except Exception:
        return 0


def _valid_hhmm(s: str) -> bool:
    try:
        h, m = s.split(":")
        return 0 <= int(h) <= 23 and 0 <= int(m) <= 59
    except Exception:
        return False


_SEP = "\x1f"
# 记忆分组顺序（跟角色顺序一致）
MEM_ORDER = list(PERSONAS.keys())


def _mem_split(user_id):
    """把记忆按角色拆开。

    返回 (全局列表, {角色: 列表})，每项是 (显示文字, persona+key)。
    全局记忆单独一组，因为它被所有角色共享。
    """
    shared = []
    per = {p: [] for p in MEM_ORDER}
    if not user_id:
        return shared, per

    for m in repo.list_all_memories(user_id):
        label = ("🔒 " if m["pinned"] else "") + m["value"]
        val = m["persona"] + _SEP + m["key"]
        if m["persona"] == "__global__":
            shared.append((label, val))
        elif m["persona"] in per:
            per[m["persona"]].append((label, val))
    return shared, per


def _pin_stat(user_id):
    """「已锁 N / 上限」——超出的话那几条根本进不了她的记忆。"""
    if not user_id:
        return ""
    n = sum(1 for m in repo.list_all_memories(user_id) if m.get("pinned"))
    if n <= MEMORY_PINNED_MAX:
        return f"**已锁 {n} / {MEMORY_PINNED_MAX}**"
    over = n - MEMORY_PINNED_MAX
    return (f"**已锁 {n} / {MEMORY_PINNED_MAX}**　"
            f"⚠️ 超出 {over} 条，这 {over} 条不会出现在她的记忆里")


def _mem_refresh(user_id):
    """返回：统计文字 + 所有记忆分组的新选项（全局 + MEM_ORDER）。"""
    shared, per = _mem_split(user_id)
    return [gr.update(value=_pin_stat(user_id))] + [
        gr.update(choices=shared, value=[])
    ] + [
        gr.update(choices=per[p], value=[]) for p in MEM_ORDER
    ]


def _split_value(v):
    if not v or _SEP not in str(v):
        return (None, None)
    p, k = str(v).split(_SEP, 1)
    return (p, k)


def do_save_memory_mode(user_id, choice):
    """保存"她的记性"。choice 是界面上的中文选项。"""
    if not user_id:
        return "先登录。"
    try:
        from core import memory_state as _ms
        _ms.ensure_schema()
        mode = _ms.MODE_MIXED if choice == "像人" else _ms.MODE_PURE
        _ms.set_user_mode(user_id, mode)
        _label = "像人（会记不清一些事，但记得重要的）" if mode == _ms.MODE_MIXED \
            else "记得细（什么细节都记得，但偶尔像数据库）"
        return "已保存：**%s**。下一句开始生效。" % _label
    except Exception as e:
        return "保存失败：%s" % e


def do_preview_memory(user_id, persona):
    """拿他上一句话，把两种模式的注入段并排打出来。"""
    if not user_id:
        return "先登录。", "先登录。"
    try:
        from core import recall as _recall
        from core import memory_state as _ms
        from core import daily as _daily
        from db import repository as _repo

        msgs = _repo.get_recent_messages(user_id, persona, limit=20) or []
        last = ""
        for m in reversed(msgs):
            if m.get("role") == "user":
                last = m.get("content") or ""
                break
        if not last.strip():
            return "还没有你说过的话，先去聊两句。", "还没有你说过的话，先去聊两句。"

        _kws = _recall.keywords(last)
        hits = _recall.search(user_id, persona, last, exclude_days=2,
                              limit=8, drop_words=(persona, "小光", "师姐"))
        if not hits:
            return ("上一句：**%s**\n\n没有检索到旧记录。" % last,
                    "上一句：**%s**\n\n没有检索到旧记录。" % last)

        try:
            _diary = _daily.recent(user_id, persona, days=2) or []
        except Exception:
            _diary = []
        _dd = set(str(d)[:10] for d, _s in _diary)

        try:
            _pinned = _repo.get_memories_pinned(user_id, persona, limit=50) or []
            _perm = [x.get("value") for x in _pinned]
        except Exception:
            _perm = []

        def _fmt(mode):
            txt, info = _ms.render(user_id, persona, hits, mode=mode,
                                   permanent_values=_perm, diary_days=_dd,
                                   recall_kws=_kws)
            head = "```\n%s\n```" % _ms.log_line(info)
            body = txt if txt else "（空）"
            return "**%s**\n\n%s\n\n```\n%s\n```" % (
                "pure · 原样" if mode == _ms.MODE_PURE else "mixed · 三档",
                head, body.strip())

        return _fmt(_ms.MODE_PURE), _fmt(_ms.MODE_MIXED)
    except Exception as e:
        return "出错：%s" % e, "出错：%s" % e


def do_save_prefs(user_id, style, quiet_on, start, end):
    if not user_id:
        return "请先登录"
    repo.set_user_pref(user_id, "reply_style", style or "normal")
    if quiet_on:
        s = (start or "").strip()
        e = (end or "").strip()
        if not (_valid_hhmm(s) and _valid_hhmm(e)):
            return "时间要写成 `23:30` 这种格式"
        repo.set_user_pref(user_id, "quiet_start", s)
        repo.set_user_pref(user_id, "quiet_end", e)
    else:
        repo.set_user_pref(user_id, "quiet_start", "")
        repo.set_user_pref(user_id, "quiet_end", "")
    return "✅ 已保存"


def do_mem_action(user_id, action, *groups):
    """锁定 / 解锁 / 忘掉。groups 是所有分组的勾选结果，合并后统一处理。"""
    if not user_id:
        return ("请先登录", *_mem_refresh(user_id))

    sel = []
    for g in groups:
        sel.extend(g or [])
    if not sel:
        return ("先勾选几条", *_mem_refresh(user_id))

    n = 0
    for v in sel:
        p, k = _split_value(v)
        if not p:
            continue
        if action == "lock":
            repo.set_memory_pinned(user_id, p, k, 1)
        elif action == "unlock":
            repo.set_memory_pinned(user_id, p, k, 0)
        elif action == "delete":
            repo.delete_memory_any(user_id, p, k)
        n += 1

    word = {"lock": "锁定", "unlock": "取消锁定", "delete": "忘掉"}.get(action, "处理")
    return (f"✅ 已{word} {n} 条", *_mem_refresh(user_id))


def do_pin(user_id, target, text):
    """手动让她记住一件事。存进指定角色（或所有角色），锁定，永不被裁剪。"""
    if not user_id:
        return ("请先登录", *_mem_refresh(user_id))
    t = (text or "").strip()
    if not t:
        return ("写点什么再点保存", *_mem_refresh(user_id))

    persona = "__global__" if target == "所有角色" else (target or DEFAULT_PERSONA)
    key = "lock:" + t[:20]
    repo.upsert_memory(user_id, persona, key, t[:120], priority=9)
    repo.set_memory_pinned(user_id, persona, key, 1)
    return ("✅ 记住了，这条不会被忘掉", *_mem_refresh(user_id))


def render_profile(user_id):
    """个人主页：身份、额度、四个角色的关系、统计。

    数据全是现成的，这里只做展示，不改任何业务逻辑。
    """
    if not user_id:
        return ""

    user = repo.get_or_create_user(user_id) or {}
    role_txt = permissions.role_name(user)

    balance = float(user.get("balance") or 0)
    days = _days_since(user.get("created_at")) + 1
    total_msgs = repo.count_messages(user_id)
    total_ms = len(repo.get_milestones(user_id))

    def stat(caption, value, sub=""):
        sub_html = f'<div style="font-size:11px;color:#a0a5ad">{sub}</div>' if sub else ""
        return (
            '<div style="flex:1;min-width:140px;background:#fff;border:1px solid #e6e8ec;'
            'border-radius:12px;padding:14px 16px">'
            f'<div style="font-size:12px;color:#8b9099">{caption}</div>'
            f'<div style="font-size:18px;font-weight:600;color:#20242b;margin-top:2px">{value}</div>'
            f'{sub_html}</div>'
        )

    mem_n = repo.count_memories(user_id)
    head = (
        '<div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px">'
        + stat("身份", role_txt)
        + stat("剩余额度", f"{balance:.2f} 元", "1 元 ≈ 100 条")
        + stat("来过", f"{days} 天")
        + stat("说话", f"{total_msgs} 句", f"纪念 {total_ms} 件")
        + stat("她记得", f"{mem_n} 件", "在下面「她的记忆」里")
        + "</div>"
    )

    cards = []
    for p in PERSONAS:
        st = repo.get_character_state(user_id, p) or {}
        intimacy = float(st.get("intimacy") or 0)
        is_lover = bool(st.get("confessed_at"))
        stage = relationship.get_stage(intimacy, is_lover)
        together = (_days_since(st.get("confessed_at")) + 1) if is_lover else 0
        line = relationship.stage_line(stage, intimacy, is_lover, together)
        pct = relationship.calc_progress(intimacy, stage)

        cards.append(
            '<div style="background:#fff;border:1px solid #e6e8ec;border-radius:14px;'
            'padding:16px 18px">'
            '<div style="display:flex;justify-content:space-between;align-items:baseline">'
            f'<div style="font-size:15px;font-weight:600;color:#20242b">{p}</div>'
            f'<div style="font-size:12px;color:#a0a5ad">{intimacy:.0f}</div>'
            "</div>"
            '<div style="height:6px;background:#eef0f3;border-radius:99px;overflow:hidden;'
            'margin:10px 0">'
            f'<i style="display:block;height:100%;width:{pct}%;'
            'background:linear-gradient(90deg,#7ba7a0,#c8553d)"></i>'
            "</div>"
            f'<div style="font-size:12px;color:#6b7280;line-height:1.7">{line}</div>'
            "</div>"
        )

    return (
        '<div style="max-width:780px">'
        + head
        + '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px">'
        + "".join(cards)
        + "</div></div>"
    )


def open_profile(user_id, persona=None):
    persona = persona or DEFAULT_PERSONA
    style = repo.get_user_pref(user_id, "reply_style", "normal") if user_id else "normal"
    qs = repo.get_user_pref(user_id, "quiet_start", "") if user_id else ""
    qe = repo.get_user_pref(user_id, "quiet_end", "") if user_id else ""
    # 「她的记性」单选框要显示已保存的值，不然会永远停在默认那个
    try:
        from core import memory_state as _ms
        _mm = "像人" if _ms.resolve_mode(user_id) == _ms.MODE_MIXED else "记得细"
    except Exception:
        _mm = "像人"
    return (
        gr.update(visible=False),          # chat_group
        gr.update(visible=True),           # profile_group
        render_profile(user_id),           # profile_html
        gr.update(value=style),            # style_radio
        gr.update(value=bool(qs and qe)),  # quiet_on
        gr.update(value=qs or "23:30"),    # quiet_start
        gr.update(value=qe or "07:00"),    # quiet_end
        gr.update(value=_mm),              # mem_radio
        *_mem_refresh(user_id),            # 全局 + 6 个角色的记忆分组
        gr.update(value=persona),          # pin_target 默认当前角色
    )


def do_change_password(user_id, old_pwd, new_pwd, new_pwd2):
    if not user_id:
        return "请先登录"
    user = repo.get_or_create_user(user_id) or {}
    if not verify_password(old_pwd or "", user.get("password_hash") or ""):
        return "❌ 旧密码不对"
    ok, msg = validate_password(new_pwd or "")
    if not ok:
        return f"❌ {msg}"
    if new_pwd != new_pwd2:
        return "❌ 两次新密码不一致"
    repo.update_password(user_id, hash_password(new_pwd))
    return "✅ 密码已修改，下次用新密码登录"


