    # 进个人主页（藏起聊天区）
    _mem_outputs = [pin_stat, mem_global] + [mem_boxes[p] for p in MEM_ORDER]
    pf_btn.click(
        open_profile,
        [user_id_state, persona_state],
        [chat_group, profile_group, profile_html, style_radio, quiet_on,
         quiet_start, quiet_end, mem_radio] + _mem_outputs + [pin_target],
    )

    # 保存说话方式 / 免打扰
    mem_save.click(
        do_save_memory_mode,
        inputs=[user_id_state, mem_radio],
        outputs=[mem_msg],
    )
    mem_preview.click(
        do_preview_memory,
        inputs=[user_id_state, persona_state],
        outputs=[mem_out_pure, mem_out_mixed],
    )
    pref_btn.click(
        do_save_prefs,
        [user_id_state, style_radio, quiet_on, quiet_start, quiet_end],
        [pref_msg],
    )

    # 记忆管理：锁定 / 取消锁定 / 忘掉（所有分组一起处理）
    _mem_inputs = [user_id_state] + _mem_outputs
    _mem_results = [mem_msg] + _mem_outputs
    mem_lock_btn.click(
        lambda u, *gs: do_mem_action(u, "lock", *gs),
        _mem_inputs, _mem_results,
    )
    mem_unlock_btn.click(
        lambda u, *gs: do_mem_action(u, "unlock", *gs),
        _mem_inputs, _mem_results,
    )
    mem_del_btn.click(
        lambda u, *gs: do_mem_action(u, "delete", *gs),
        _mem_inputs, _mem_results,
    )
    pin_btn.click(
        do_pin,
        [user_id_state, pin_target, pin_text],
        _mem_results,
    )

    # 从主页回聊天
    pf_back_btn.click(
        lambda: (gr.update(visible=True), gr.update(visible=False)),
        None,
        [chat_group, profile_group],
    )

    # 改密码
    pwd_btn.click(
        do_change_password,
        [user_id_state, old_pwd, new_pwd, new_pwd2],
        [pwd_msg],
    )

    new_btn_open.click(toggle_create, None, [create_group])

    del_btn.click(
        do_delete_persona,
        [user_id_state],
        [del_msg, persona_dropdown, create_group],
    ).then(
        lambda p: p,
        [persona_dropdown],
        [persona_state],
    )

    new_go.click(
        do_create_persona,
        [new_name, new_call, new_quote, new_state, new_target,
         user_id_state, session_id_state, new_raw],
        [new_msg, create_group, persona_dropdown, chatbot, bg_layer, session_id_state],
    ).then(
        lambda p: p,
        [persona_dropdown],
        [persona_state],
    ).then(
        render_relationship,
        [user_id_state, persona_state],
        [relationship_html],
    )

    persona_dropdown.change(
        switch_persona,
        [persona_dropdown, user_id_state, session_id_state],
        [chatbot, bg_layer, session_id_state],
    ).then(
        lambda p: p,
        [persona_dropdown],
        [persona_state],
    ).then(
        render_relationship,
        [user_id_state, persona_state],
        [relationship_html],
    ).then(
        _refresh_stage_wrap,
        [user_id_state, persona_state],
        [stage_bar, tell_btn, farewell_md, farewell_group],
    )

    bg_set.click(
        do_set_bg,
        [user_id_state, bg_persona, bg_img],
        [bg_msg],
    )

    bg_reset.click(
        do_reset_bg,
        [user_id_state, bg_persona],
        [bg_msg],
    )

    export_load.click(
        do_export_refresh,
        [user_id_state],
        [export_msg, export_persona],
    )

    export_txt_btn.click(
        do_export_txt,
        [user_id_state, export_persona],
        [export_msg],
    )

    export_book_btn.click(
        do_export_book,
        [user_id_state, export_persona],
        [export_msg],
    )

    export_all_btn.click(
        do_export_all,
        [user_id_state],
        [export_msg],
    )

    story_go.click(
        do_story_start,
        [user_id_state, story_origin, persona_state],
        [story_msg, story_list],
    ).then(
        do_story_refresh,
        [user_id_state],
        [story_quota, story_list],
    )

    story_refresh.click(
        do_story_refresh,
        [user_id_state],
        [story_quota, story_list],
    )

    tell_btn.click(show_tell_confirm, None, [tell_confirm_group])
    tell_no.click(hide_tell_confirm, None, [tell_confirm_group])
    tell_yes.click(
        do_tell,
        [user_id_state, persona_state],
        [stage_bar, tell_btn, farewell_md, farewell_group],
    ).then(
        hide_tell_confirm, None, [tell_confirm_group],
    )

    msg.submit(
        respond,
        [msg, chatbot, user_id_state, session_id_state, persona_state, guest_token_state],
        [msg, chatbot, relationship_html, typing_status,
         guest_save_group, guest_end_md],
    ).then(
        _refresh_stage_wrap,
        [user_id_state, persona_state],
        [stage_bar, tell_btn, farewell_md, farewell_group],
    )
    send_btn.click(
        respond,
        [msg, chatbot, user_id_state, session_id_state, persona_state, guest_token_state],
        [msg, chatbot, relationship_html, typing_status,
         guest_save_group, guest_end_md],
    ).then(
        _refresh_stage_wrap,
        [user_id_state, persona_state],
        [stage_bar, tell_btn, farewell_md, farewell_group],
    )
    clear_btn.click(clear_chat, None, [chatbot, session_id_state])

    # 页脚：备案号（所有页面底部都显示）
    gr.HTML(FOOTER_HTML)


# ---- IP 地区拦截（默认关闭；开关在 ipblock.json）----
# 注意：launch() 会用 App.create_app() 重新建一个 app，
# 直接给 demo.app 挂中间件会被丢掉。所以这里包装 create_app。
# 纯 ASGI 中间件，不缓冲响应，不影响流式输出。
# 关闭时只做一次 os.stat，零开销；查询失败一律放行。
from core.ipblock import IPBlockMiddleware
import gradio.routes as _gr_routes

_orig_create_app = _gr_routes.App.create_app


def _story_page(sid: str):
    """把一份生成好的剧情渲染成网页。"""
    from fastapi.responses import HTMLResponse

    row = repo.get_story(sid)
    if not row:
        return HTMLResponse("<meta charset='utf-8'><h2>找不到这一份</h2>", status_code=404)
    if row.get("status") != "done":
        msg = story_jobs.status_line(row)
        return HTMLResponse(
            "<meta charset='utf-8'><meta http-equiv='refresh' content='4'>"
            "<body style='background:#14171c;color:#e8e6e3;font-family:sans-serif;"
            "display:flex;align-items:center;justify-content:center;height:100vh;margin:0'>"
            "<div style='text-align:center'><h2 style='font-weight:400'>%s</h2>"
            "<p style='color:#8a9099;font-size:14px'>这个页面每 4 秒自动刷新</p></div></body>" % msg,
            status_code=200,
        )

    try:
        import json as _json
        with open(row["file"], encoding="utf-8") as f:
            data = _json.load(f)
        title = "%s · %s" % (row.get("origin") or "", row.get("city") or "")
        return HTMLResponse(gplayer.render_html(data, title))
    except Exception as e:
        return HTMLResponse("<meta charset='utf-8'><h2>读不出来：%s</h2>" % e, status_code=500)


def _keepsake_file(name: str, dl: int = 0):
    """把纪念册 / 聊天记录发给浏览器。

    文件名是纯 ASCII 短码（不会有编码问题）。
    友好名（中文）存在同名 .name 边车里，下载时塞进 Content-Disposition。
    """
    from fastapi.responses import FileResponse, HTMLResponse
    import re as _re

    if not _re.fullmatch(r"[A-Za-z0-9_-]{1,64}(\.[A-Za-z0-9]{1,6})?", name or ""):
        return HTMLResponse("<meta charset='utf-8'><h2>地址不对</h2>", status_code=400)

    path = os.path.join(gkeep.OUT_DIR, name)
    if not os.path.isfile(path) or name.endswith(".name"):
        return HTMLResponse("<meta charset='utf-8'><h2>找不到这一份</h2>", status_code=404)

    media = ("text/plain; charset=utf-8" if name.endswith(".txt")
             else "text/html; charset=utf-8")
    if dl:
        return FileResponse(path, media_type=media,
                            filename=name)
    return FileResponse(path, media_type=media)


def _keepsake_dl(name: str):
    """下载专用路径。不用查询参数 —— nginx 那边对 ?dl=1 处理不稳，会偶发 400。"""
    return _keepsake_file(name, 1)


def _create_app_with_ipblock(*args, **kwargs):
    _app = _orig_create_app(*args, **kwargs)
    try:
        _app.add_api_route("/story/{sid}", _story_page, methods=["GET"])
        _app.add_api_route("/keepsake/dl/{name}", _keepsake_dl, methods=["GET"])
        _app.add_api_route("/keepsake/{name}", _keepsake_file, methods=["GET"])
    except Exception as _e:
        print(f"[剧情] 播放页路由挂载失败：{_e}", flush=True)
    try:
        _app.add_middleware(IPBlockMiddleware)
    except Exception as _e:
        # 挂不上就放行所有请求，绝不因为拦截功能把站点搞挂
        print(f"[IP拦截] 中间件挂载失败，全部放行：{_e}", flush=True)
    return _app


_gr_routes.App.create_app = staticmethod(_create_app_with_ipblock)

# ==========================================================
# 一个无用的函数
# ==========================================================
# 它永远不会被调用。
# 它不返回任何东西，也不改变任何东西。
# 留在这里，是因为一个仓库里总该有一处
# 不为了功能而存在的地方。


def _nothing():
    """什么都不做。"""
    return None


# ==========================================================


if __name__ == "__main__":
    _where = "只有本机可访问" if HOST == "127.0.0.1" else "局域网 / 公网可访问"
    print(f"[启动] 监听 {HOST}:{PORT}（{_where}）", flush=True)
    demo.queue(default_concurrency_limit=None).launch(
        server_name=HOST,
        server_port=PORT,
        allowed_paths=[os.path.abspath("static")],
    )